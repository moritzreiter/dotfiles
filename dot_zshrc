# launch tmux
# if interactive
# and tmux exists
# and not already in tmux
# and not in JetBrains term
if [[ $- == *i* ]] && \
   command -v tmux >/dev/null 2>&1 && \
   [[ -z "$TMUX" ]] && \
   [[ "$TERMINAL_EMULATOR" != "JetBrains-JediTerm" ]]; then
    exec tmux new-session -A -s default
fi

export PATH="$HOME/bin:$PATH"

# launch starship
eval "$(starship init zsh)"

# nicer file listings with eza
if command -v eza >/dev/null 2>&1; then
    alias ll="eza -l -g --icons --git"
    alias la="eza -la -g --icons --git"
    alias lt="eza -1 --icons --tree --git-ignore"
fi

# Homebrew setup
if type brew &>/dev/null; then
  eval "$(brew shellenv)"

  # Completions
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH
  autoload -Uz compinit
  compinit
fi

case "$OSTYPE" in
    darwin*)
        share="$(brew --prefix)/share"
        zsh_autosuggestions="$share/zsh-autosuggestions/zsh-autosuggestions.zsh"
        zsh_syntax_highlighting="$share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
        zsh_history_substring_search="$share/zsh-history-substring-search/zsh-history-substring-search.zsh"
        ;;
    linux*)
        share="/usr/share"
        zsh_autosuggestions="$share/zsh-autosuggestions/zsh-autosuggestions.zsh"
        zsh_syntax_highlighting="$share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
        zsh_history_substring_search="$HOME/.config/zsh/zsh-history-substring-search/zsh-history-substring-search.zsh"
        ;;
    *)
        echo "Unknow operating system, can't config zsh plugins..."
        ;;
esac

# https://github.com/marlonrichert/zsh-autocomplete
#source $share_dir/zsh-autocomplete/zsh-autocomplete.plugin.zsh

# fish-like auto-suggestions
source $zsh_autosuggestions
bindkey '^F' autosuggest-accept

# fish-like syntax-highlighting
source $zsh_syntax_highlighting

# fish-like history search
# git clone https://github.com/zsh-users/zsh-history-substring-search \
#   ~/.config/zsh/zsh-history-substring-search
source $zsh_history_substring_search
bindkey -M viins '^P' history-substring-search-up
bindkey -M viins '^N' history-substring-search-down
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

# Syncs the value of SSH_AUTH_SOCK to tmux before every
# zsh command execution. This ensures ssh agent forwarding
# works after a reconnect into an existing tmux session.
__refresh_ssh_auth_sock() {
    [[ -z "$TMUX" ]] && return

    local tmux_env
    tmux_env=$(tmux show-environment SSH_AUTH_SOCK 2>/dev/null)

    [[ -z "$tmux_env" ]] && return

    local latest="${tmux_env#SSH_AUTH_SOCK=}"

    if [[ "$SSH_AUTH_SOCK" != "$latest" ]]; then
        export SSH_AUTH_SOCK="$latest"
    fi
}

if [[ "$OSTYPE" == linux* ]]; then
    autoload -Uz add-zsh-hook
    add-zsh-hook preexec __refresh_ssh_auth_sock
fi

